package com.senai.projeto.service;

import java.util.List;
import com.senai.projeto.entity.FuncionariosEntity;
import com.senai.projeto.repository.FuncionariosRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

@Service

public class FuncionariosService {
    @Autowired
    private FuncionariosRepository funcionariosRepository;

    // LISTAR TODOS
    public List<FuncionariosEntity> listarTodos() {
        return funcionariosRepository.findAll();
    }

    //SALVAR
    public FuncionariosEntity salvarFuncionarios(FuncionariosEntity funcionarios) {
        if (funcionariosRepository.findByEmail(funcionarios.getEmail()).isPresent()) {
            throw new IllegalArgumentException("Funcionário já cadastrado.");
        }
        return funcionariosRepository.save(funcionarios);
    }

    // ATUALIZAR
    public FuncionariosEntity atualizar(Long id, FuncionariosEntity funcionarios) {
        if (!funcionariosRepository.existsById(id)) {
            throw new IllegalArgumentException("Funcionário não encontrado.");
        }
        funcionarios.setId(id);
        return funcionariosRepository.save(funcionarios);
    }

    // DELETE - excluir o Funcionario.
    public void excluirFuncionarios(Long id) {

        // verifica se o Funcionario está cadastrado.
        if (!funcionariosRepository.existsById(id)) {
            throw new IllegalArgumentException("Funcionário não encontrado.");
        }
        //irá excluir um funcionario com id cadastrado.
        funcionariosRepository.deleteById(id);
    }
}
